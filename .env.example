# ChatBook LLM 配置
# 用于 AI 深度人物画像分析和对话建议生成

# LLM API Key（必填，用于调用 LLM）
# DeepSeek: https://platform.deepseek.com/api_keys
# OpenAI: https://platform.openai.com/api-keys
CHATBOOK_LLM_API_KEY=

# LLM API Base URL（可选，默认 DeepSeek）
# DeepSeek: https://api.deepseek.com/v1
# OpenAI: https://api.openai.com/v1
# 自定义：http://localhost:11434/v1 (Ollama)
CHATBOOK_LLM_BASE_URL=https://api.deepseek.com/v1

# LLM Model（可选，默认 deepseek-chat）
# DeepSeek: deepseek-chat
# OpenAI: gpt-4o, gpt-4o-mini
# Ollama: llama3, qwen2 等
CHATBOOK_LLM_MODEL=deepseek-chat
